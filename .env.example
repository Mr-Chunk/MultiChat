# Copy this file to .env for local testing, or set these as environment variables on your host.

# The public address of your MultiChat site (no trailing slash). Sign-in redirect URLs are built from this.
BASE_URL=https://multichat.example.com

# Where the database and uploads are stored. On a host, point this at a persistent volume.
DATA_DIR=/data

# Sign-in providers — create an app on each developer site (see DEPLOY.md). Leave a pair empty to hide that button.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional
# UPLOAD_QUOTA_MB=100      # upload space per streamer
# MAX_YT_RELAYS=1000       # max YouTube channels watched at once
